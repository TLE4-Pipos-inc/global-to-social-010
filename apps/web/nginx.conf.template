server {
  listen 8002;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Reverse-proxy API calls to the backend. Same-origin keeps httpOnly auth
  # cookies working. The bare proxy_pass (no path) preserves the full /api/...
  # URI, matching how the API mounts its routes.
  location /api/ {
    proxy_pass ${API_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  # SPA fallback for client-side (TanStack Router) routes
  location / {
    try_files $uri $uri/ /index.html;
  }
}
